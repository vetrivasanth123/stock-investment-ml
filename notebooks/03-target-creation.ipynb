        "# ============================================================\n",
        "# PHASE 3 — TARGET CREATION\n",
        "# Cell 2: Official NIFTY 50 NTR Benchmark Acquisition & Validation\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import requests\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"PHASE 3 — NIFTY 50 NTR BENCHMARK\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Dynamic benchmark date range\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "history_start_date = pd.to_datetime(\n",
        "    recent_history[\"trade_date\"].min()\n",
        ")\n",
        "latest_trade_date = pd.to_datetime(\n",
        "    recent_history[\"trade_date\"].max()\n",
        ")\n",
        "\n",
        "start_date = history_start_date.strftime(\"%d/%m/%Y\")\n",
        "end_date = latest_trade_date.strftime(\"%d/%m/%Y\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Official NIFTY 50 NTR endpoint\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "endpoint = (\n",
        "    \"https://www.niftyindices.com\"\n",
        "    \"/BackPage/getTotalReturnIndexString\"\n",
        ")\n",
        "\n",
        "headers = {\n",
        "    \"User-Agent\": (\n",
        "        \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) \"\n",
        "        \"AppleWebKit/537.36 (KHTML, like Gecko) \"\n",
        "        \"Chrome/140.0.0.0 Safari/537.36\"\n",
        "    ),\n",
        "    \"Accept\": \"application/json,text/javascript,*/*;q=0.9\",\n",
        "    \"Content-Type\": \"application/json; charset=UTF-8\",\n",
        "}\n",
        "\n",
        "request_string = (\n",
        "    \"{\"\n",
        "    f\"'name':'NIFTY 50',\"\n",
        "    f\"'startDate':'{start_date}',\"\n",
        "    f\"'endDate':'{end_date}',\"\n",
        "    f\"'indexName':'NIFTY 50'\"\n",
        "    \"}\"\n",
        ")\n",
        "\n",
        "response = requests.post(\n",
        "    endpoint,\n",
        "    headers=headers,\n",
        "    json={\"cinfo\": request_string},\n",
        "    timeout=60,\n",
        ")\n",
        "\n",
        "if response.status_code != 200:\n",
        "    raise RuntimeError(\n",
        "        f\"NIFTY Total Return endpoint failed: HTTP {response.status_code}\"\n",
        "    )\n",
        "\n",
        "result = response.json()\n",
        "\n",
        "if isinstance(result, dict) and \"d\" in result:\n",
        "    result = result[\"d\"]\n",
        "    if isinstance(result, str):\n",
        "        result = json.loads(result)\n",
        "\n",
        "if not isinstance(result, list) or not result:\n",
        "    raise RuntimeError(\"NIFTY endpoint returned no usable records.\")\n",
        "\n",
        "nifty_ntr = pd.DataFrame(result)\n",
        "\n",
        "required_columns = {\"Date\", \"NTR_Value\"}\n",
        "missing_columns = required_columns - set(nifty_ntr.columns)\n",
        "\n",
        "if missing_columns:\n",
        "    raise RuntimeError(\n",
        "        f\"Required NIFTY NTR columns missing: {sorted(missing_columns)}\"\n",
        "    )\n",
        "\n",
        "nifty_ntr = nifty_ntr[[\"Date\", \"NTR_Value\"]].copy()\n",
        "nifty_ntr[\"trade_date\"] = pd.to_datetime(\n",
        "    nifty_ntr[\"Date\"],\n",
        "    dayfirst=True,\n",
        "    errors=\"coerce\",\n",
        ")\n",
        "nifty_ntr[\"ntr_value\"] = pd.to_numeric(\n",
        "    nifty_ntr[\"NTR_Value\"],\n",
        "    errors=\"coerce\",\n",
        ")\n",
        "\n",
        "nifty_ntr = (\n",
        "    nifty_ntr[[\"trade_date\", \"ntr_value\"]]\n",
        "    .dropna()\n",
        "    .drop_duplicates(\"trade_date\")\n",
        "    .sort_values(\"trade_date\")\n",
        "    .reset_index(drop=True)\n",
        ")\n\n",
        "nifty_ntr = nifty_ntr[\n",
        "    nifty_ntr[\"trade_date\"].between(\n",
        "        history_start_date,\n",
        "        latest_trade_date,\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "if nifty_ntr.empty or (nifty_ntr[\"ntr_value\"] <= 0).any():\n",
        "    raise RuntimeError(\"Invalid NIFTY NTR data detected.\")\n",
        "\n",
        "if nifty_ntr[\"trade_date\"].duplicated().any():\n",
        "    raise RuntimeError(\"Duplicate NIFTY NTR dates detected.\")\n",
        "\n",
        "nifty_ntr_benchmark = nifty_ntr.copy()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Benchmark coverage validation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "market_calendar = pd.Series(\n",
        "    pd.to_datetime(recent_history[\"trade_date\"])\n",
        "    .drop_duplicates()\n",
        "    .sort_values()\n",
        ").reset_index(drop=True)\n",
        "\n",
        "ntr_calendar = pd.Series(\n",
        "    nifty_ntr_benchmark[\"trade_date\"]\n",
        "    .drop_duplicates()\n",
        "    .sort_values()\n",
        ").reset_index(drop=True)\n",
        "\n",
        "missing_ntr_dates = market_calendar[\n",
        "    ~market_calendar.isin(ntr_calendar)\n",
        "].reset_index(drop=True)\n",
        "\n",
        "# Primary current ~1-year window.\n",
        "current_window_start = market_calendar.iloc[-252]\n",
        "current_market_dates = market_calendar[\n",
        "    market_calendar.between(\n",
        "        current_window_start,\n",
        "        latest_trade_date,\n",
        "    )\n",
        "]\n",
        "\n",
        "current_missing = current_market_dates[\n",
        "    ~current_market_dates.isin(ntr_calendar)\n",
        "]\n",
        "\n",
        "current_coverage = (\n",
        "    1 - len(current_missing) / len(current_market_dates)\n",
        ")\n",
        "\n",
        "print(f\"\\nNTR rows              : {len(nifty_ntr_benchmark):,}\")\n",
        "print(f\"NTR start             : {nifty_ntr_benchmark['trade_date'].min().date()}\")\n",
        "print(f\"NTR latest            : {nifty_ntr_benchmark['trade_date'].max().date()}\")\n",
        "print(f\"Duplicate dates       : {nifty_ntr_benchmark['trade_date'].duplicated().sum():,}\")\n",
        "print(f\"Missing market dates  : {len(missing_ntr_dates):,}\")\n",
        "print(f\"Current-window missing: {len(current_missing):,}\")\n",
        "print(f\"Current-window coverage: {current_coverage:.4%}\")\n",
        "\n",
        "if len(current_missing) != 0:\n",
        "    raise RuntimeError(\n",
        "        \"NIFTY NTR does not fully cover the current 252-day window.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nRecent NIFTY 50 NTR observations:\")\n",
        "print(nifty_ntr_benchmark.tail(10).to_string(index=False))\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"PHASE 3 CELL 2: PASSED\")\n",
        "print(\"=\" * 60)"
      ]
    },
