      "source": [
        "# ============================================================\n",
        "# PHASE 3 — TARGET CREATION\n",
        "# Cell 1: Dynamic Market Refresh, Windows & Target Eligibility\n",
        "# ============================================================\n",
        "\n",
        "from datetime import date, timedelta\n",
        "import pandas as pd\n",
        "\n",
        "from src.data.providers import nse_market\n",
        "\n",
        "\n",
        "TARGET_HORIZON = 252\n",
        "\n",
        "if \"recent_history\" not in globals():\n",
        "    raise RuntimeError(\n",
        "        \"`recent_history` is not available. \"\n",
        "        \"Load the verified Phase 2 market dataset first.\"\n",
        "    )\n",
        "\n",
        "recent_history[\"trade_date\"] = pd.to_datetime(\n",
        "    recent_history[\"trade_date\"],\n",
        "    errors=\"coerce\",\n",
        ")\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"PHASE 3 — DYNAMIC MARKET & TARGET SETUP\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Refresh to latest available trading date\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "current_latest_date = recent_history[\"trade_date\"].max().date()\n",
        "today = date.today()\n",
        "refresh_start = current_latest_date + timedelta(days=1)\n",
        "\n",
        "print(f\"\\nCurrent data ends : {current_latest_date}\")\n",
        "print(f\"Today's date      : {today}\")\n",
        "\n",
        "if refresh_start <= today:\n",
        "    try:\n",
        "        new_market_data = nse_market.collect_market_data(\n",
        "            refresh_start,\n",
        "            today,\n",
        "        )\n",
        "    except RuntimeError as exc:\n",
        "        print(\"\\nNo new trading-session data was available.\")\n",
        "        print(f\"Collector message: {exc}\")\n",
        "        new_market_data = pd.DataFrame()\n",
        "\n",
        "    if not new_market_data.empty:\n",
        "        new_market_data[\"trade_date\"] = pd.to_datetime(\n",
        "            new_market_data[\"trade_date\"],\n",
        "            errors=\"coerce\",\n",
        "        )\n",
        "        recent_history = pd.concat(\n",
        "            [recent_history, new_market_data],\n",
        "            ignore_index=True,\n",
        "        )\n",
        "        recent_history = (\n",
        "            recent_history\n",
        "            .drop_duplicates(\n",
        "                subset=[\"trade_date\", \"instrument_id\"]\n",
        "            )\n",
        "            .sort_values([\"nse_symbol\", \"trade_date\"])\n",
        "            .reset_index(drop=True)\n",
        "        )\n",
        "        print(f\"\\nNew rows acquired: {len(new_market_data):,}\")\n",
        "    else:\n",
        "        print(\"\\nNo new market rows added.\")\n",
        "else:\n",
        "    print(\"\\nMarket data is already current.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Dynamic trading calendar and current windows\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "latest_trade_date = pd.Timestamp(\n",
        "    recent_history[\"trade_date\"].max()\n",
        ")\n",
        "\n",
        "trading_calendar = (\n",
        "    recent_history[\"trade_date\"]\n",
        "    .drop_duplicates()\n",
        "    .sort_values()\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "if len(trading_calendar) < TARGET_HORIZON:\n",
        "    raise ValueError(\n",
        "        \"Insufficient history for the 252-trading-day horizon.\"\n",
        "    )\n",
        "\n",
        "analysis_windows = {\n",
        "    \"latest_1_trading_day\": 1,\n",
        "    \"latest_5_trading_days\": 5,\n",
        "    \"latest_20_trading_days\": 20,\n",
        "    \"latest_60_trading_days\": 60,\n",
        "    \"latest_126_trading_days\": 126,\n",
        "    \"latest_252_trading_days\": 252,\n",
        "}\n",
        "\n",
        "window_df = pd.DataFrame([\n",
        "    {\n",
        "        \"window\": name,\n",
        "        \"trading_days\": days,\n",
        "        \"start_date\": trading_calendar.iloc[-days],\n",
        "        \"end_date\": latest_trade_date,\n",
        "    }\n",
        "    for name, days in analysis_windows.items()\n",
        "    if len(trading_calendar) >= days\n",
        "])\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"MARKET DATA STATUS\")\n",
        "print(\"=\" * 60)\n",
        "print(f\"\\nLatest available trading date: {latest_trade_date.date()}\")\n",
        "print(f\"Trading days available: {len(trading_calendar):,}\")\n",
        "print(f\"Companies available: {recent_history['isin'].nunique():,}\")\n",
        "print(f\"Rows available: {len(recent_history):,}\")\n",
        "print(\"\\nDynamic investment windows:\")\n",
        "display(window_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. 252-day target eligibility calendar\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "target_calendar = pd.DataFrame({\n",
        "    \"decision_date\": trading_calendar.iloc[:-TARGET_HORIZON].to_numpy(),\n",
        "    \"target_end_date\": trading_calendar.iloc[TARGET_HORIZON:].to_numpy(),\n",
        "})\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"TARGET ELIGIBILITY\")\n",
        "print(\"=\" * 60)\n",
        "print(f\"\\nTarget-eligible dates  : {len(target_calendar):,}\")\n",
        "print(f\"First eligible date    : {target_calendar['decision_date'].min().date()}\")\n",
        "print(f\"Last eligible date     : {target_calendar['decision_date'].max().date()}\")\n",
        "print(f\"Latest target-end date : {target_calendar['target_end_date'].max().date()}\")\n",
        "print(f\"Current inference date : {latest_trade_date.date()}\")\n",
        "\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"PHASE 3 CELL 1: PASSED\")\n",
        "print(\"=\" * 60)"
      ]
    },
